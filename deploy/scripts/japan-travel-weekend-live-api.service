[Unit]
Description=Japan Travel Weekend live API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/japan-travel-weekend-live-api
Environment=NODE_ENV=production
ExecStart=/home/ubuntu/.local/jtw-node22/bin/node --env-file=/home/ubuntu/japan-travel-weekend-live-api/.env.server.live.local /home/ubuntu/japan-travel-weekend-live-api/.server-dist/server/runtime.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only

[Install]
WantedBy=multi-user.target
